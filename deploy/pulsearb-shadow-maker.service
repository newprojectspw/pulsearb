# PULSEARB SHADOW da rota MAKER nos pools de reward — o relógio do 4.2.
#
# ESTA É A FORMA DE UMA RODADA SÓ. Para as quatro do 4.2 (base + as três
# regras experimentais), use `pulsearb-shadow-maker@.service`, que é template:
# as quatro correm sobre o MESMO mercado, nos mesmos 14 dias, em vez de em
# semanas diferentes — quatro rodadas em semanas diferentes comparam a regra
# com o mercado, não com a base. Ver RUNBOOK §10.1c.
#
# Não rode as duas: esta unit já liga o recolher, e correria em duplicata com
# a instância `@recolher`.
#
#   sudo cp deploy/pulsearb-shadow-maker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pulsearb-shadow-maker
#
# O que esta unit faz, e o que ela NÃO faz: decide e anota; não envia ordem.
# MODE=SHADOW troca o cliente de ordens pelo sombra (`ClienteSombraDeOrdens`,
# todo id com prefixo `sombra-`), e a trava tripla do LIVE (risk/autorizacao.py)
# continua fechada — não há PULSEARB_CONFIRM_LIVE aqui, e não deve haver.
#
# PULSEARB_DESCOBRIR_POOLS_DE_REWARD=true é o opt-in que liga a descoberta de
# pools (a cada 300 s) e põe o LacoMaker a cotar os mercados de horizonte
# longo — os ~120 maiores pools (top_de_pools_de_reward). Sem ela a rodada é a
# do taker, que está medida e reprovada.
#
# Restart=ON-FAILURE, e NÃO `always`. O recorder roda para sempre; esta
# rodada tem prazo. Com `always`, o systemd reiniciava o processo 10 s depois
# de ele SAIR BEM — as duas semanas terminavam, o processo encerrava limpo, e
# uma rodada NOVA começava sozinha, anexando ao mesmo diário, para sempre
# (revisão do Codex, #131). O `main` já devolve 0 no sucesso e 1 quando a
# rodada não produziu saída, então `on-failure` diz exatamente o que se
# quer: rodada que terminou fica terminada, rodada que caiu volta.
#
# E o que `on-failure` NÃO resolve: um restart no MEIO da rodada. A
# `CaixaDoMaker` não persiste nada e o `run` refaz `inicio_parede`, então
# cada subida começa a contar do zero. O que salva a medida é o leitor:
# `scripts/resumo_da_rodada_maker.py` corta o fluxo de relatos onde `parede_s`
# cai e SOMA os trechos, porque os campos da caixa são cumulativos desde a
# subida — o último relato de cada trecho é o total daquele trecho. O que se
# perde são os segundos entre a queda e a volta, que não foram observados e
# por isso não contam para as duas semanas.

[Unit]
Description=PULSEARB SHADOW maker (4.2) — cota nos pools, nao envia
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pulsearb
Group=pulsearb
WorkingDirectory=/opt/pulsearb

# Mesma razão do recorder: ProtectSystem=strict exige a pasta existente ANTES
# de o Python subir (226/NAMESPACE se não existir).
ExecStartPre=+/bin/mkdir -p /opt/pulsearb/data/diarios /opt/pulsearb/data/risco
ExecStartPre=+/bin/chown -R pulsearb:pulsearb /opt/pulsearb/data

Environment=PULSEARB_MODE=SHADOW
Environment=PULSEARB_DESCOBRIR_POOLS_DE_REWARD=true

# O PERFIL DO ENSAIO, escrito aqui de propósito. Os defaults do projeto são
# os do taker (5 shares, 5/15/50 USDC, spread 0,04) e com eles esta rota não
# cota NADA: a descoberta descarta todo pool cujo rewards_min_size passa de 5,
# e o portão de risco recusa uma cotação de 1.000 shares. O bot não sobe os
# tetos sozinho (quadro, 4.0 (c)); quem sobe é o operador, e este arquivo é o
# operador escrevendo. São os valores das rodadas r4–r8 de 2026-09-14. Vale
# SÓ em SHADOW — nenhum destes números autoriza dinheiro: MODE=SHADOW acima
# troca o cliente pelo sombra, e a trava tripla do LIVE segue fechada.
Environment=PULSEARB_TAMANHO_DA_COTACAO_MAKER_SHARES=1000
Environment=PULSEARB_TOP_DE_POOLS_DE_REWARD=60
Environment=PULSEARB_RISK__STAKE_MAX_POR_TRADE_USDC=1000
Environment=PULSEARB_RISK__STAKE_MAX_POR_JANELA_USDC=2000
Environment=PULSEARB_RISK__EXPOSICAO_MAX_USDC=120000
Environment=PULSEARB_RISK__POSICOES_MAX_ABERTAS=120
Environment=PULSEARB_RISK__SPREAD_MAXIMO=0.06
# Recolher quando o melhor bid cai abaixo da cotação — a regra dos makers dos
# leaderboards, medida na gravação (−583 → −32 USDC em 4 h). Ligada AQUI para
# o SHADOW medir se o sono de 1 s basta; o relato tem de mostrar
# `livro_andou_contra` entre os motivos.
Environment=PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=true
# Âncora do microprice (quadro 4.0 (f)): DESLIGADA de propósito nesta unit.
# Ela muda o PREÇO enviado e o recolher acima muda QUANDO a ordem sai — as
# duas juntas na mesma rodada não se distinguem, e nenhuma das duas fica
# medida. A rodada que medir a âncora troca UMA pela outra, as duas linhas
# juntas — ligar só a de baixo deixaria as duas ligadas:
#   PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=false
#   PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=1
# Pausa por fill tóxico (4.0 (g)): idem, uma rodada só dela, medida em 30 s
# (90 s matam o fill). Também troca pela linha do recolher, não soma:
#   PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=30
# O relato de 60 s publica `maker.regras`: mais de uma ligada = rodada
# confundida, e nenhuma das regras fica medida.
# Registro de risco PRÓPRIO: o registro do taker em SHADOW carrega perdas
# sintéticas que armam o disjuntor e pausam o portão compartilhado — e o
# maker entra pelo mesmo portão (achados das rodadas r2 e r6). O modo sufixa
# o nome (`.shadow.json`).
Environment=PULSEARB_RISK__CAMINHO_DO_REGISTRO=data/risco/registro_maker_4_2.json

ExecStart=/opt/pulsearb/.venv/bin/python -m pulsearb.live.shadow --duration 14d --diario data/diarios/shadow-maker-4-2.jsonl

# Opcional. Se um dia houver segredo aqui, ele vem de arquivo 0600, nunca da
# unit (que é legível por todos).
#
# AQUI O RISCO É MAIOR QUE NO TEMPLATE, e vale escrever: o `systemd.exec(5)`
# diz que QUALQUER `EnvironmentFile=` vence as linhas `Environment=`. Todo o
# perfil do ensaio acima é `Environment=`, então um `.env` de máquina que
# definisse uma regra do maker ou um teto de risco venceria o arquivo
# versionado — e a rodada mediria outro perfil por 14 dias, em silêncio
# (revisão do Codex, #131). Este arquivo carrega SEGREDO, e só.
EnvironmentFile=-/opt/pulsearb/.env

Restart=on-failure
# Saída 2 é ERRO DO OPERADOR, não rodada que caiu: o `main` devolve 2 quando
# pedem LIVE a este processo e quando o `--ate` não é um instante válido (a
# variável vazia no `comum.env` chega aqui). Reerguer nesses casos seria um
# laço de restart a cada 10 s para sempre, sem nunca consertar nada — e com
# `StartLimitIntervalSec=0` nem o limite de partidas o seguraria. Saída 1
# (rodada que falhou) continua reerguendo, que é o ponto do `on-failure`.
RestartPreventExitStatus=2
RestartSec=10

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/opt/pulsearb/data

[Install]
WantedBy=multi-user.target
