# Rodada do RECOLHER — quadro 4.0 (e).
#
# Recolhe a cotação quando o melhor bid cai abaixo dela: a regra dos makers
# dos leaderboards, medida na gravação (−583 → −32 USDC em 4 h). Muda QUANDO
# a ordem sai do livro.
#
# O relato tem de mostrar `livro_andou_contra` entre os motivos na primeira
# hora; zero com o livro andando quer dizer que esta variável não pegou.
PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=true
PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=
PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=
