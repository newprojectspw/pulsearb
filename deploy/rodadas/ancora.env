# Rodada da ÂNCORA DO MICROPRICE — quadro 4.0 (f).
#
# Repousar ACIMA do microprice é ser a opção grátis de quem atravessa; o
# limite duro é o microprice, e este valor é a preferência de colocação em
# ticks abaixo dele. Muda o PREÇO enviado — por isso não corre junto com o
# recolher DENTRO da mesma rodada (correm em processos irmãos, sobre o mesmo
# mercado, que é o contrário de confundir).
#
# 1 tick é o valor medido (+36,09 contra +7,37 da base, na hora de fumaça de
# 13/09); 3 ticks REPROVOU (−3,32).
#
# ATENÇÃO: 0 é um valor LIGADO válido (o limite vira o microprice exato), não
# "desligado". Desligado é a variável VAZIA, como nas outras duas linhas.
PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=false
PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=1
PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=

# Registro de risco PRÓPRIO DESTA RODADA, e mora aqui e não na unit porque
# `EnvironmentFile` vence `Environment=`: um `.env` de máquina com este nome
# daria às QUATRO instâncias o MESMO registro, e o `_gravar` do portão monta
# o `.tmp` a partir deste caminho — duas rodadas no mesmo registro escrevem o
# mesmo temporário e o rename atômico pode publicar uma mistura.
PULSEARB_RISK__CAMINHO_DO_REGISTRO=data/risco/registro_maker_ancora.json
