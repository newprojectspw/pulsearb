# Rodada da PAUSA POR FILL TÓXICO — quadro 4.0 (g).
#
# Quem atravessa a cotação paga acima do nosso preço para entrar AGORA, e em
# geral sabe de algo que o livro ainda não mostrou; cotar no minuto seguinte é
# oferecer a mesma opção de graça outra vez. Muda QUANDO a ordem VOLTA.
#
# 30 s é a janela medida (+18,42 contra +14,24 da base); 90 s REPROVOU
# (−0,52 — a janela longa mata o fill). Fill no NÍVEL não pausa: é a fila
# andando.
#
# ATENÇÃO: 0 é um valor LIGADO válido (pausa de duração zero), não
# "desligado". Desligado é a variável VAZIA.
PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=false
PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=
PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=30

# Registro de risco PRÓPRIO DESTA RODADA, e mora aqui e não na unit porque
# `EnvironmentFile` vence `Environment=`: um `.env` de máquina com este nome
# daria às QUATRO instâncias o MESMO registro, e o `_gravar` do portão monta
# o `.tmp` a partir deste caminho — duas rodadas no mesmo registro escrevem o
# mesmo temporário e o rename atômico pode publicar uma mistura.
PULSEARB_RISK__CAMINHO_DO_REGISTRO=data/risco/registro_maker_pausa.json
