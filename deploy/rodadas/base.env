# Rodada BASE do 4.2 — nenhuma regra experimental.
#
# É ela que dá o de-para: sem uma base correndo nos MESMOS 14 dias, o líquido
# das outras três não se compara com nada (comparar com uma rodada de outra
# semana mede a semana, não a regra).
#
# As quatro linhas aparecem mesmo valendo o default. Regra que não está
# escrita é regra que ninguém confere, e o custo do engano aqui são 14 dias —
# e sem a linha vazia, um `PULSEARB_MAKER_FRACAO_MAXIMA_DO_POOL` de máquina
# vazaria para as quatro instâncias (o `.env` da máquina é lido antes destes).
PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=false
PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=
PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=
PULSEARB_MAKER_FRACAO_MAXIMA_DO_POOL=

# Registro de risco PRÓPRIO DESTA RODADA, e mora aqui e não na unit porque
# `EnvironmentFile` vence `Environment=`: um `.env` de máquina com este nome
# daria às QUATRO instâncias o MESMO registro, e o `_gravar` do portão monta
# o `.tmp` a partir deste caminho — duas rodadas no mesmo registro escrevem o
# mesmo temporário e o rename atômico pode publicar uma mistura.
PULSEARB_RISK__CAMINHO_DO_REGISTRO=data/risco/registro_maker_base.json
