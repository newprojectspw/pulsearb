# Rodada BASE do 4.2 — nenhuma regra experimental.
#
# É ela que dá o de-para: sem uma base correndo nos MESMOS 14 dias, o líquido
# das outras três não se compara com nada (comparar com uma rodada de outra
# semana mede a semana, não a regra).
#
# As três linhas aparecem mesmo valendo o default. Regra que não está escrita
# é regra que ninguém confere, e o custo do engano aqui são 14 dias.
PULSEARB_MAKER_RECOLHE_QUANDO_O_LIVRO_ANDA=false
PULSEARB_MAKER_TICKS_ABAIXO_DO_MICROPRICE=
PULSEARB_MAKER_PAUSA_APOS_FILL_TOXICO_S=
