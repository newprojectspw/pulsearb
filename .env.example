# PULSEARB — copie para .env e preencha. O .env real NUNCA é commitado.
#
# No M1 não há segredo nenhum: tudo é leitura pública (L0).
# Private key e credenciais de API só entram no M4, e só na VPS.

# Modo de execução: SIM (default) | SHADOW | LIVE
# LIVE exige ALÉM disso o arquivo CONFIRM_LIVE na raiz e a frase de
# confirmação no prompt de inicialização (trava tripla do M4).
PULSEARB_MODE=SIM

# Sobrescreve o user_agent do config.yaml, se quiser.
# PULSEARB_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) pulsearb/0.1"

# ---- M4+ (deixe vazio/ausente até lá) ----
# PULSEARB_PRIVATE_KEY=
# PULSEARB_API_KEY=
# PULSEARB_API_SECRET=
# PULSEARB_API_PASSPHRASE=
# PULSEARB_FUNDER_ADDRESS=
